# mtrtk configuration. Copy to .env and edit: cp .env.example .env
# Every key below is a field of `Settings` (src/mtrtk/config.py); values are the code defaults.
# An empty value means "unset" and leaves the field at its default (None), except NTRIP_PASSWORD,
# where an empty value means anonymous NTRIP access.
# Note: a key with an empty value must not carry a trailing comment - .env parsers would read
# the comment as the value - so those keys are documented on the line above instead.

# ---------------------------------------------------------------- role / receiver
ROLE=base                         # base | rover
MTRTK_SOURCE=auto                 # auto | /dev/serial/by-id/usb-u-blox_... | file:/data/replay.ubx
BAUD=115200
DATA_DIR=/data
# MTRTK_ENV_FILE: the file the web UI rewrites when settings change; defaults to .env
STATION_ID=MTRK                   # 4 upper-case chars, used in file names and RINEX marker
COUNTRY=BGD                       # ISO 3166-1 alpha-3, used in RINEX 3 file names
MARKER_NAME=MTRK
ANTENNA_TYPE=NONE                 # IGS antenna code, NONE for uncalibrated antennas
ANTENNA_HEIGHT_M=0.0              # ARP height above the mark
OBSERVER=mtrtk
AGENCY=mtrtk
# RECEIVER_STRICT: 1 = a rejected core CFG key aborts startup (exit 1); 0 = warn and run on
RECEIVER_STRICT=1
REPLAY_SPEED=1.0                  # file-source pacing multiplier; 0 = as fast as possible
REPLAY_LOOP=0                     # 1 = restart a file source at EOF instead of stopping
REPLAY_LOG=0                      # 1 = also write raw logs when MTRTK_SOURCE is a file (tests/demos)

# ---------------------------------------------------------------- base station
BASE_MODE=survey-in               # survey-in | fixed | off
SVIN_MIN_DURATION_S=300           # 1..86400
SVIN_ACC_LIMIT_M=2.0              # >0..100
# ACTIVE_SITE: name of a saved site, used when BASE_MODE=fixed
ACTIVE_SITE=
RTCM_MSM=7                        # 7 (1077/1087/1097/1127) or 4 (1074/1084/1094/1124)
RTCM_1230_RATE=5                  # seconds between RTCM 1230 (GLONASS biases)
RTCM_STATION_ID=0                 # RTCM DF003 reference station id (0-4095)

# ---------------------------------------------------------------- NTRIP caster
NTRIP_BIND=tailscale              # tailscale | lan | all | <ip>
NTRIP_PORT=2101
MOUNTPOINT=MTRK
NTRIP_USER=rover
NTRIP_PASSWORD=change-me          # empty value = anonymous access (tailnet only!)
NTRIP_MAX_CLIENTS=32              # rovers served at once; further ones get 503 / ERROR

# ---------------------------------------------------------------- web UI
WEB_BIND=tailscale                # tailscale | lan | all | <ip>
WEB_PORT=8080
# WEB_PASSWORD: required unless WEB_BIND=tailscale (or WEB_ALLOW_INSECURE=1)
WEB_PASSWORD=
WEB_ALLOW_INSECURE=0

# ---------------------------------------------------------------- raw logging
LOG_MESSAGES=RXM-RAWX,RXM-SFRBX,NAV-PVT,NAV-HPPOSLLH,NAV-SVIN,TIM-TM2,MON-VER
MIN_FREE_GB=5.0
FSYNC_INTERVAL_S=10

# ---------------------------------------------------------------- rover
ROVER_DRIVER=ublox                # ublox | sbg_ellipse | vectornav
ROVER_NAV_HZ=5                    # 1-8
ROVER_DYNMODEL=portable           # portable | stationary | pedestrian | automotive | airborne1g | airborne2g | airborne4g
# NTRIP_URL: correction source for the rover, e.g. ntrip://user:pass@base-host:2101/MTRK
NTRIP_URL=
NTRIP_GGA_INTERVAL_S=10
# NMEA_TCP_PORT: NMEA TCP server on every interface; -1 turns it off (0 picks a free port
# and logs it, which is for tests, not for turning the server off)
NMEA_TCP_PORT=10110
# NMEA_SENTENCES: any of GGA,RMC,GST,GSA,GSV,VTG,ZDA,HDT,PASHR (HDT/PASHR need attitude)
NMEA_SENTENCES=GGA,RMC,GST,GSA,GSV,VTG,ZDA
NMEA_SLOW_INTERVAL_S=1.0          # seconds between GSA/GSV/ZDA bursts
# NMEA_UDP_TARGETS: comma-separated host:port list, e.g. 192.168.1.20:10110,192.168.1.21:10110
NMEA_UDP_TARGETS=
# NMEA_SERIAL: serial port to mirror NMEA to, e.g. /dev/ttyUSB1
NMEA_SERIAL=
# NMEA_SERIAL_BAUD: line speed of NMEA_SERIAL (the consumer's, e.g. 4800/9600/38400; not BAUD)
NMEA_SERIAL_BAUD=115200
# JSON_UDP_PORT: UDP port (1-65535) on 127.0.0.1 for the JSON state feed; empty = off
JSON_UDP_PORT=
POINT_EPOCHS=30                   # default averaging length for survey points (1-3600)
POINT_FIXED_ONLY=1                # only accept RTK fixed epochs when collecting

# ---------------------------------------------------------------- alerts / exposure
ALERT_WEBHOOK_URL=
# PUBLIC_DOMAIN: for the 'public' compose profile (Caddy TLS), Phase 9
PUBLIC_DOMAIN=
# TUNNEL_TOKEN: read by the 'cloudflare' compose profile, not by Settings; Phase 9
TUNNEL_TOKEN=

# ---------------------------------------------------------------- INS drivers (ROVER_DRIVER=sbg_ellipse|vectornav)
# INS_PORT: serial device of the INS unit; required for sbg_ellipse / vectornav (no auto-detect,
# FTDI ids are generic), e.g. /dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXX-if00-port0
INS_PORT=
# INS_BAUD: the unit's port baud rate (the bench SBG Ellipse-D port A runs at 921600)
INS_BAUD=115200
# INS_RTCM_PORT: SBG only - separate serial device carrying RTCM to the unit's Port B; empty = main port
INS_RTCM_PORT=
INS_OUTPUT_HZ=10                  # navigation output rate, 1-200
INS_APPLY_CONFIG=0                # 1 = write the vendor config subset on connect
INS_RAW_GNSS=1                    # capture the unit's raw GNSS stream for PPK
# INS_LEVER_ARM_GNSS1 / _GNSS2: IMU -> antenna lever arm in metres, body frame, "x,y,z"
INS_LEVER_ARM_GNSS1=
INS_LEVER_ARM_GNSS2=
# INS_IMU_LEVER_ARM: SBG only - IMU lever arm in metres, "x,y,z"
INS_IMU_LEVER_ARM=
INS_IMU_AXIS=xyz                  # SBG axis mapping
INS_MOTION_PROFILE=general        # general | automotive | marine | airplane | helicopter | uav | pedestrian (per vendor)
# INS_INIT_POSITION: initial position for the unit's filter, "lat,lon,alt" (degrees, metres)
INS_INIT_POSITION=

# ---------------------------------------------------------------- VectorNav (ROVER_DRIVER=vectornav)
INS_VN_RTCM=0                     # 1 = forward RTCM to the VN-200 (undocumented for that unit; unverified)
# INS_VN_SCENARIO / INS_VN_AHRS_AIDING: register 67 INS basic configuration; empty = leave as is
INS_VN_SCENARIO=
INS_VN_AHRS_AIDING=
# INS_VN_REF_ROTATION: register 26 reference frame rotation, 9 comma floats row-major; empty = leave
INS_VN_REF_ROTATION=
# INS_VN_VPE: register 35 VPE basic control "enable,headingMode,filteringMode,tuningMode"; empty = leave
INS_VN_VPE=

# ---------------------------------------------------------------- ROS 2 bridge (docker compose --profile ros2)
# Read by docker compose for the mtrtk-ros2 service, not by Settings; see docs/ros2.md.
ROS_DISTRO=humble                 # humble (Ubuntu 22.04 / JetPack 6) or jazzy (Ubuntu 24.04)
ROS_DOMAIN_ID=0
# MTRTK_WS_URL: the daemon's WebSocket. 127.0.0.1 needs WEB_BIND=lan|all|127.0.0.1; with
# WEB_BIND=tailscale use ws://<tailscale-ip>:8080/ws
MTRTK_WS_URL=ws://127.0.0.1:8080/ws   # add ?token=<web token> when WEB_PASSWORD is set
