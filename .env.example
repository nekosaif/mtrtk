# mtrtk configuration. Copy to .env and edit: cp .env.example .env
# Every key below is a field of `Settings` (src/mtrtk/config.py); values are the code defaults.
# An empty value means "unset" and leaves the field at its default (None), except NTRIP_PASSWORD,
# where an empty value means anonymous NTRIP access.
# Note: a key with an empty value must not carry a trailing comment - .env parsers would read
# the comment as the value - so those keys are documented on the line above instead.

# ---------------------------------------------------------------- role / receiver
ROLE=base                         # base | rover
MTRTK_SOURCE=auto                 # auto | /dev/serial/by-id/usb-u-blox_... | file:/data/replay.ubx
BAUD=115200
DATA_DIR=/data
STATION_ID=MTRK                   # 4 upper-case chars, used in file names and RINEX marker
COUNTRY=BGD                       # ISO 3166-1 alpha-3, used in RINEX 3 file names
MARKER_NAME=MTRK
ANTENNA_TYPE=NONE                 # IGS antenna code, NONE for uncalibrated antennas
ANTENNA_HEIGHT_M=0.0              # ARP height above the mark
OBSERVER=mtrtk
AGENCY=mtrtk
# RECEIVER_STRICT: 1 = a rejected core CFG key aborts startup (exit 1); 0 = warn and run on
RECEIVER_STRICT=1
REPLAY_SPEED=1.0                  # file-source pacing multiplier; 0 = as fast as possible
REPLAY_LOOP=0                     # 1 = restart a file source at EOF instead of stopping
REPLAY_LOG=0                      # 1 = also write raw logs when MTRTK_SOURCE is a file (tests/demos)

# ---------------------------------------------------------------- base station
BASE_MODE=survey-in               # survey-in | fixed | off
SVIN_MIN_DURATION_S=300
SVIN_ACC_LIMIT_M=2.0
# ACTIVE_SITE: name of a saved site, used when BASE_MODE=fixed
ACTIVE_SITE=
RTCM_MSM=7                        # 7 (1077/1087/1097/1127) or 4 (1074/1084/1094/1124)
RTCM_1230_RATE=5                  # seconds between RTCM 1230 (GLONASS biases)
RTCM_STATION_ID=0                 # RTCM DF003 reference station id (0-4095)

# ---------------------------------------------------------------- NTRIP caster
NTRIP_BIND=tailscale              # tailscale | lan | all | <ip>
NTRIP_PORT=2101
MOUNTPOINT=MTRK
NTRIP_USER=rover
NTRIP_PASSWORD=change-me          # empty value = anonymous access (tailnet only!)

# ---------------------------------------------------------------- web UI
WEB_BIND=tailscale                # tailscale | lan | all | <ip>
WEB_PORT=8080
# WEB_PASSWORD: required unless WEB_BIND=tailscale (or WEB_ALLOW_INSECURE=1)
WEB_PASSWORD=
WEB_ALLOW_INSECURE=0

# ---------------------------------------------------------------- raw logging
LOG_MESSAGES=RXM-RAWX,RXM-SFRBX,NAV-PVT,NAV-HPPOSLLH,NAV-SVIN,TIM-TM2,MON-VER
MIN_FREE_GB=5.0
FSYNC_INTERVAL_S=10

# ---------------------------------------------------------------- rover
ROVER_DRIVER=ublox                # ublox | sbg_ellipse | vectornav
ROVER_NAV_HZ=5                    # 1-8
ROVER_DYNMODEL=portable           # portable | stationary | pedestrian | automotive | airborne1g | airborne2g | airborne4g
# NTRIP_URL: correction source for the rover, e.g. ntrip://user:pass@base-host:2101/MTRK
NTRIP_URL=
NTRIP_GGA_INTERVAL_S=10
NMEA_TCP_PORT=10110
# NMEA_UDP_TARGETS: comma-separated host:port list, e.g. 192.168.1.20:10110,192.168.1.21:10110
NMEA_UDP_TARGETS=
# NMEA_SERIAL: serial port to mirror NMEA to, e.g. /dev/ttyUSB1
NMEA_SERIAL=
# JSON_UDP_PORT: UDP port for the JSON state feed
JSON_UDP_PORT=

# ---------------------------------------------------------------- alerts / exposure
ALERT_WEBHOOK_URL=
# PUBLIC_DOMAIN: for the 'public' compose profile (Caddy TLS), Phase 9
PUBLIC_DOMAIN=
# TUNNEL_TOKEN: read by the 'cloudflare' compose profile, not by Settings; Phase 9
TUNNEL_TOKEN=
