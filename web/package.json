    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.15"
