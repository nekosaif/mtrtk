<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mtrtk_bridge</name>
  <version>0.1.0</version>
  <description>Publishes the mtrtk GNSS/RTK rover state (NavSatFix, velocity, RTK status, time marks) from the mtrtk daemon WebSocket.</description>
  <maintainer email="mongol-tori@bracu.ac.bd">mtrtk</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nmea_msgs</depend>
  <depend>mtrtk_msgs</depend>
  <exec_depend>python3-websocket</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
